using CallAdmin.Handlers;
using Exiled.API.Features;
using Exiled.Events.Handlers;
using System;

namespace CallAdmin
{
    public sealed class Plugin : Plugin<Config>
    {
        public static Plugin Instance { get; private set; }

        private ServerHandlers _serverHandlers;

        public override string Name              => "CallAdmin";
        public override string Author            => "YourName";
        public override string Prefix            => "call_admin";
        public override Version Version          => new(1, 0, 0);
        public override Version RequiredExiledVersion => new(8, 0, 0);

        public override void OnEnabled()
        {
            Instance = this;

            _serverHandlers = new ServerHandlers();
            Server.Restarting += _serverHandlers.OnRoundRestarted;

            Log.Info("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
            Log.Info($"  {Name} v{Version} by {Author}");
            Log.Info("  Status: ENABLED ✓");
            Log.Info("  Command: .call [reason]");
            Log.Info($"  Cooldown: {Config.CooldownSeconds}s");
            Log.Info("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

            base.OnEnabled();
        }

        public override void OnDisabled()
        {
            Server.Restarting -= _serverHandlers.OnRoundRestarted;
            _serverHandlers = null;
            Instance = null;

            Log.Info($"{Name} — disabled.");
            base.OnDisabled();
        }
    }
}
